--TEST--
Test octdec - bigint values for 64bit and 32bit platforms
--FILE--
<?php

define("MAX_64Bit", 9223372036854775807);
define("MAX_32Bit", 2147483647);
define("MIN_64Bit", -9223372036854775807 - 1);
define("MIN_32Bit", -2147483647 - 1);

$octLongStrs = array(
   '777777777777777777777',
   '1777777777777777777777',
   '17777777777',
   '37777777777',
   '377777777777777777777777',
   '17777777777777777777777777',
   '377777777777',
   '777777777777',
);


foreach ($octLongStrs as $strVal) {
   echo "--- testing: $strVal ---\n";
   var_dump(octdec($strVal));
}

?>
--EXPECT--
--- testing: 777777777777777777777 ---
int(9223372036854775807)
--- testing: 1777777777777777777777 ---
int(18446744073709551615)
--- testing: 17777777777 ---
int(2147483647)
--- testing: 37777777777 ---
int(4294967295)
--- testing: 377777777777777777777777 ---
int(2361183241434822606847)
--- testing: 17777777777777777777777777 ---
int(75557863725914323419135)
--- testing: 377777777777 ---
int(34359738367)
--- testing: 777777777777 ---
int(68719476735)
