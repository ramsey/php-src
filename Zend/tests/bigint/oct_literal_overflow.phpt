--TEST--
Bigint: octal integer literal overflowing ZEND_LONG becomes int, not float
--FILE--
<?php
var_dump(0o1000000000000000000000);
var_dump(0O1777777777777777777777);
var_dump(01000000000000000000000);
var_dump(-0o1000000000000000000000);
var_dump(-01000000000000000000000);
var_dump(is_int(0o1000000000000000000000));
var_dump(0o777777777777777777777);
?>
--EXPECT--
int(9223372036854775808)
int(18446744073709551615)
int(9223372036854775808)
int(-9223372036854775808)
int(-9223372036854775808)
bool(true)
int(9223372036854775807)
